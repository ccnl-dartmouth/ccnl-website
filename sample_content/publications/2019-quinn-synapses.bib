@article{alumnus2019synapses,
  author = {Alumnus, Quinn and Investigator, Pat},
  title = {Synaptic plasticity at multiple timescales supports flexible learning},
  journal = {Neural Examples},
  volume = {4},
  number = {3},
  pages = {301--318},
  year = {2019},
  doi = {10.1000/example.2019.3},
  abstract = {Models of learning usually assume a single plasticity rate. We show that two rates are enough to learn quickly from recent outcomes while retaining stable long-term values, and that the two-rate model predicts patterns seen in animal behavior.},
}
