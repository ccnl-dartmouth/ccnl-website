@article{khorsand2015combined,
  author = {Khorsand, P and Moore, T and Soltani, A},
  title = {Combined Contribution of Feedforward and Feedback Inputs to Bottom-up Attention},
  journal = {Frontiers in Psychology},
  volume = {6},
  number = {155},
  pages = {1--11},
  year = {2015},
  doi = {10.3389/fpsyg.2015.00155},
