@article{spitmaan2019salience,
  author = {Spitmaan, MM and Chu, E and Soltani, A},
  title = {Salience-Driven Value Construction for Adaptive Choice under Risk},
  journal = {Journal of Neuroscience},
  volume = {39},
  number = {26},
  pages = {5195--5209},
  year = {2019},
  doi = {10.1523/jneurosci.2522-18.2019},
  cofirst = {Spitmaan, Chu},
