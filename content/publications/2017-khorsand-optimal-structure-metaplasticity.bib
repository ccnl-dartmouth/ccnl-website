@article{khorsand2017optimal,
  author = {Khorsand, P and Soltani, A},
  title = {Optimal Structure of Metaplasticity for Adaptive Learning},
  journal = {PLOS Computational Biology},
  volume = {13},
  number = {6},
  pages = {e1005630},
  year = {2017},
  doi = {10.1371/journal.pcbi.1005630},
