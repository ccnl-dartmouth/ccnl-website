@article{harris2021unique,
  author = {Harris, C and Aguirre, CG and Kolli, S and Das, K and Izquierdo, A and Soltani, A},
  title = {Unique Features of Stimulus-based Probabilistic Reversal Learning},
  journal = {Behavioral Neuroscience},
  volume = {135},
  number = {4},
  pages = {550--570},
  year = {2021},
  doi = {10.1037/bne0000474},
  cofirst = {Harris, Aguirre},
